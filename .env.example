# Databricks Workspace Connection
DATABRICKS_HOST=https://adb-1234567890123456.7.azuredatabricks.net
DATABRICKS_WORKSPACE_ID=1234567890123456

# Authorization Mode: PAT or SERVICE_PRINCIPAL (SP)
DATABRICKS_AUTH_TYPE=SERVICE_PRINCIPAL

# Personal Access Token (Used if DATABRICKS_AUTH_TYPE=PAT)
DATABRICKS_TOKEN=dapi_sample_token_secret_12345

# Service Principal Credentials (Used if DATABRICKS_AUTH_TYPE=SERVICE_PRINCIPAL or SP)
DATABRICKS_CLIENT_ID=sp-client-id-0000-1111
DATABRICKS_CLIENT_SECRET=sp-client-secret-xxxx
DATABRICKS_TENANT_ID=00000000-0000-0000-0000-000000000000

# Storage
USE_FIRESTORE=false
FIRESTORE_COLLECTION=databricks_clusters
LOCAL_DB_PATH=databricks_store.json
